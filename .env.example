# diplomatAI Environment Configuration
# Copy this file to .env and fill in the values

# Gateway URL (used by the Dashboard to reach the Java Gateway)
GATEWAY_URL=http://localhost:8080/api/v1/chat

# Quality Check Service URL (used by the Gateway)
QC_SERVICE_URL=http://localhost:8000

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# PostgreSQL Configuration (sessions, messages, users, per-user registered models)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diplomatai
SPRING_DATASOURCE_USERNAME=diplomat
SPRING_DATASOURCE_PASSWORD=diplomat_secret

# JWT — change these secrets before deploying anywhere real
JWT_SECRET=diplomatai_jwt_secret_key_change_in_production_min32chars

# Global cap on model calls per minute across the gateway (default 60; use 5 to demo rate-limit fallback)
LLM_RATE_LIMIT_PER_MINUTE=60

# AES key used to encrypt provider API keys at rest in Postgres
API_KEY_ENCRYPTION_SECRET=diplomatai_api_key_encryption_secret_change_in_production
